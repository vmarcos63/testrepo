[Unit]
Description=Listener de EMSC (sismos publicados en la región)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/testrepo
EnvironmentFile=/home/ubuntu/testrepo/sismo/.env
ExecStart=/home/ubuntu/testrepo/.venv/bin/python -m sismo.emsc_listener
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

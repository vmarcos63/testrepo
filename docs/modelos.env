# Única fuente de verdad nivel -> modelo (leída por scripts/run-clite.sh).
# IDs tomados de la doc oficial de ClinePass (oct-2026). Verificar con tu CLI: clite config
# Hipótesis inicial de asignación: se valida/ajusta con docs/ledger.csv.
N1_MODEL="cline-pass/deepseek-v4.1-flash"
N1_THINKING="low"
N2_MODEL="cline-pass/minimax-m3"        # alternativas: cline-pass/mimo-v2.5-pro, cline-pass/glm-5.3
N2_THINKING="medium"
N3_MODEL="cline-pass/deepseek-v4-pro"   # alternativa: cline-pass/kimi-k3
N3_THINKING="high"
TIMEOUT_SECONDS=1200
MAX_RETRIES=3
